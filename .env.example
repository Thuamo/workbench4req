DATABASE_URL=sqlite:///./data/workbench.db
STORAGE_DIR=./data
# Optional local PlantUML renderer for the UML skill
# PLANTUML_JAR=./data/tools/plantuml.jar
# PLANTUML_JAVA=java
PUBLIC_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
SESSION_HOURS=12
UPLOAD_LIMIT_MB=30
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
EMBEDDING_DIMENSIONS=1536
# Knowledge Q&A relevance and context limits
QA_MIN_TOKEN_COVERAGE=0.25
QA_SEMANTIC_THRESHOLD=0.5
QA_CONTEXT_CHAR_LIMIT=24000
CONVERTER_EXECUTABLE=soffice
PARSE_TIMEOUT=90
SQLITE_BUSY_TIMEOUT_SECONDS=3
# Docker Compose requires your own database password and encryption key.
POSTGRES_PASSWORD=
